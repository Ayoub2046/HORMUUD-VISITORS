PORT=5000

# Set to true to force in-memory demo database (no PostgreSQL required).
# WARNING: mock data is volatile and lost on restart. Use false in production.
USE_MOCK_DB=false
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key

# Supabase Configurations
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- PostgreSQL Connection (this is how the app actually stores all data) ---
# Local dev: session pooler on port 5432
# Vercel/serverless: transaction pooler on port 6543 (?pgbouncer=true)
DATABASE_URL=postgresql://postgres.USER:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Connection Pool Settings ---
POOL_MAX_ACTIVE=20
POOL_INITIAL_SIZE=1
POOL_MIN_IDLE=1
POOL_MAX_WAIT=10000
POOL_CONNECTION_TIMEOUT=15000
DB_INIT_RETRIES=3

# --- Schema Settings ---
MASTER_SCHEMA=public
DEFAULT_SCHEMA=public
