{
  "name": "booqasho-app",
  "private": true,
  "version": "1.0.0",
  "description": "Booqasho App - Marketing Visit Management System (Vercel monorepo deployment)",
  "scripts": {
    "dev": "concurrently \"node backend/server.js\" \"npm run dev --prefix frontend\"",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "vite build --config frontend/vite.config.js --outDir dist",
    "start": "node backend/server.js",
    "start:local": "npm run dev",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.13.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
